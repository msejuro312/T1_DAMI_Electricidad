<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resultado_titulo"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_small"
            android:text="@string/resultado_descripcion"
            android:textColor="@color/gris_texto"
            android:textSize="@dimen/text_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/bg_surface_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/textViewNombreResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resultado_nombre_inicial"
                android:textColor="@color/azul_oscuro"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewPrimario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/resultado_primario_inicial"
                android:textColor="@color/azul_principal"
                android:textSize="@dimen/text_result"
                android:textStyle="bold" />

            <!--E03-->

            <TextView
                android:id="@+id/textViewSecundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:text="@string/resultado_secundario_inicial"
                android:textColor="@color/azul_oscuro"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewClasificacionResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:background="@drawable/bg_estado_chip"
                android:paddingHorizontal="@dimen/chip_padding_horizontal"
                android:paddingVertical="@dimen/chip_padding_vertical"
                android:text="@string/valor_no_disponible"
                android:textColor="@color/azul_oscuro"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center"
                android:text="@string/resultado_nota"
                android:textColor="@color/gris_texto"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVolver"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/boton_volver"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
